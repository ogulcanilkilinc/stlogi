{
  "name": "STLOgi",
  "short_name": "STLOgi",
  "description": "Baskı öncesi STL görüntüleyici (Bambu Lab A1)",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1b1e23",
  "theme_color": "#23272e",
  "lang": "tr",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "model/stl": [".stl"],
        "model/obj": [".obj"],
        "model/3mf": [".3mf"]
      },
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" },
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [".stl", ".obj", ".3mf", "model/stl", "model/obj", "model/3mf", "application/sla", "application/vnd.ms-package.3dmanufacturing-3dmodel+xml", "application/octet-stream"]
        }
      ]
    }
  }
}
